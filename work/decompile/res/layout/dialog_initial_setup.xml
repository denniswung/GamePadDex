<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">
    <ScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:padding="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/accessibility_disclosure_title"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/accessibility_disclosure_text"
                android:lineSpacingExtra="4dp"/>
            <View
                android:background="@color/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2">
                <Button
                    android:textColor="@color/accent_red"
                    android:id="@+id/btn_dialog_decline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_decline_exit"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <Button
                    android:textColor="@color/text_primary"
                    android:id="@+id/btn_dialog_accept"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_accept_continue"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_blue"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
