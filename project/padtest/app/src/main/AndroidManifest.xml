<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/ProbeTheme">

        <activity
            android:name=".ui.SelfCheckActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CursorTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.ScrollTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.KeyTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.SystemTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".ui.AutoTestActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ReportActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>

</manifest>
