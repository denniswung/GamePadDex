    <!-- ============================ about ============================ -->
    <string name="about_heading">Gamepad mouse</string>
    <string name="about_paragraph">这是对“Gamepad mouse”（com.pkyul13.gamepadmouse，v2.0.2）的干净室复刻，专注于 DeX。它完全依据原应用的公开行为从零编写：相同的偏好设置键、相同的数值范围、相同的按键映射模型，并额外提供一层接管手柄的 root / DeX 层，使三星内置的手柄处理永不干扰。\n\n无广告、无统计、无计费：原版所有“Pro”功能在这里都免费。\n\n所有设置都保存在本机的单个私有偏好设置文件中。</string>
    <string name="about_play_link">在 Google Play 上查看原应用</string>
