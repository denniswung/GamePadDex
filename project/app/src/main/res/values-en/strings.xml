    <string name="click_location_guide_title">How to Set Up Click Location</string>
    <string name="click_location_guide_msg">1. Open your game or app.\n2. Turn ON the gamepad mouse.\n3. Move the cursor to the target location.\n4. Press the mapped button combination.\n\nThe location is then saved and clicked whenever you press the combination again.</string>
    <string name="click_location_repeat_guide_title">How to Set Up Repeat Clicks</string>
    <string name="click_location_repeat_guide_msg">1. Open the game or app you want.\n2. Turn ON the gamepad mouse.\n3. Move the cursor to the location you want to click.\n4. Press the mapped button combination to save the location.\n5. Press the same combination again to start repeating clicks, and press it once more to stop.\n\nRepeating stops automatically when the mouse cursor turns off.\nLong-press a mapping row to retune its interval.\n\nTap OK to choose the repeat interval in the next step.</string>
    <string name="press_gamepad_button_title">Set Activation Button</string>
    <string name="press_gamepad_button_msg">Press any button on your gamepad to use it as the activation button.\n\n(D-Pad, Back and the volume keys cannot be used.)</string>
