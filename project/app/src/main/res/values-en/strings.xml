    <!-- ============================ about ============================ -->
    <string name="about_heading">Gamepad mouse</string>
    <string name="about_paragraph">This is a clean-room, DeX-focused replica of \"Gamepad mouse\" (com.pkyul13.gamepadmouse, v2.0.2). It was written from scratch against the public behaviour of the original app: the same preference keys, the same numeric ranges and the same button-mapping model, plus a root / DeX layer that owns the controller so Samsung\'s built-in gamepad handling never interferes.\n\nNo ads, no analytics, no billing: every former \"Pro\" feature is free here.\n\nAll settings stay on this device in a single private preferences file.</string>
    <string name="about_play_link">Original app on Google Play</string>
