<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/GpmPage">

    <TextView
        style="@style/GpmSection"
        android:text="@string/initial_setup" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="17sp"
        android:text="@string/accessibility_disclosure_title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_guide"
        android:textSize="14sp"
        android:text="@string/setup_step_1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_guide"
        android:textSize="14sp"
        android:text="@string/setup_step_2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_guide"
        android:textSize="14sp"
        android:text="@string/setup_step_3" />

    <TextView
        style="@style/GpmDesc"
        android:layout_marginTop="12dp"
        android:text="@string/setup_note" />

    <Button
        android:id="@+id/btn_open_settings"
        style="@style/GpmButton"
        android:text="@string/open_accessibility_settings" />

    <Button
        android:id="@+id/btn_battery_optimization"
        style="@style/GpmButton"
        android:text="@string/disable_battery_optimization" />

    <Button
        android:id="@+id/btn_accept_continue"
        style="@style/GpmButton"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/accent_blue"
        android:text="@string/btn_accept_continue"
        android:textColor="@color/white" />
</LinearLayout>
